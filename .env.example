# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Vision model used for every Groq call. Override it if Groq retires this one
# (that is exactly what happened to meta-llama/llama-4-scout-17b-16e-instruct,
# deprecated on 2026-06-17): set this to the new model id, no code change needed.
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Deprecated alias, still honoured if GROQ_VISION_MODEL is unset.
# VISION_MODEL=qwen/qwen3.6-27b
